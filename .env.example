# Copia questo file in ".env" e inserisci i valori del TUO progetto Supabase.
# (Project URL e anon public key: Supabase → Project Settings → API)
#
# La chiave anon è pubblica per progetto: è protetta dalle policy RLS
# definite in supabase-setup.sql. Il file .env viene pubblicato insieme
# al sito (i valori VITE_ vengono incorporati nella build): questo è
# intenzionale, così ogni dispositivo si collega al cloud automaticamente.

VITE_SUPABASE_URL=https://il-tuo-progetto.supabase.co
VITE_SUPABASE_ANON_KEY=inserisci-la-anon-public-key
